# ---------------------------------------------------------------------------
# Paradox Squad environment variables. Copy to .env.local (web) / .env (server).
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Web (apps/web, Vercel) ---
# Public site URL, used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WebSocket URL of the game server. Leave unset in development to use ws://<current host>:2567.
NEXT_PUBLIC_GAME_SERVER_URL=

# --- Game server (apps/server, Fly.io / VPS) ---
PORT=2567
# Region label for matchmaking and the server browser.
REGION=eu-central
# Simulated round-trip latency for local netcode testing (ms). 0 = off. Never set in production.
SIMULATED_LATENCY_MS=0
# Test harness only: hits never kill. Never set in production.
PARADOX_TEST_MODE=0

# --- Coming in milestone 6 (accounts & progression) ---
# DATABASE_URL=postgresql://user:password@host:5432/paradox
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

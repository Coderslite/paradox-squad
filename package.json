{
  "name": "paradox-squad",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=3",
    "dev:web": "pnpm --filter @paradox/web dev",
    "dev:server": "pnpm --filter @paradox/server dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
